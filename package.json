{
  "name": "about-me",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "",
    "build": "astro build && npm run test:seo",
    "check": "astro check && node scripts/validate-data.mjs && node scripts/validate-site-analytics.mjs && node --experimental-strip-types scripts/activity/validate.ts",
    "sync": "node scripts/sync-github.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "dev:astro": "astro dev --host 0.0.0.0 --port 4173",
    "refresh": "node scripts/sync-github.mjs && node scripts/sync-projects.mjs",
    "sync:analytics": "node scripts/sync-site-analytics.mjs",
    "sync:activity": "node --experimental-strip-types scripts/activity/sync.ts",
    "watch:activity": "node --experimental-strip-types scripts/activity/watch.ts",
    "test:seo": "node --test scripts/seo/*.test.mjs"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "three": "^0.180.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "parse5": "^7.3.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
