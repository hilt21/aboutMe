---
import '../styles/global.css';
import '../styles/profile.css';
import '../styles/activity.css';
import {Image} from 'astro:assets';
import avatar from '../assets/lu-tao-avatar.webp';
import profileRaw from '../data/profile.json';
import raw from '../data/github.json';
import projectsRaw from '../data/projects.json';
import {Snapshot,Profile,ProjectSnapshot} from '../lib/schema';
import {experienceYears,profileYear} from '../lib/experience';
import TrainDivider from '../components/TrainDivider.astro';
import ProjectArt from '../components/ProjectArt.astro';
import Background from '../components/Background.astro';
import SiteInsights from '../components/SiteInsights.astro';
import ChatGPTActivity from '../components/ChatGPTActivity.astro';
import ActivityCalendar from '../components/ActivityCalendar.astro';
import { activityCalendar } from '../lib/activity-view';
const profile=Profile.parse(profileRaw);
const year=profileYear();
const data=Snapshot.parse(raw),days=data.calendar;
const projectSnapshot=ProjectSnapshot.parse(projectsRaw);
const activeDays=days.filter(d=>d.count>0).length;
const activityEnd=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const githubDays=activityCalendar(days.map(day=>({date:day.date,value:day.count,level:day.level})),activityEnd);
const updated=data.updatedAt?new Date(data.updatedAt).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric',timeZone:'Asia/Shanghai'}):'Awaiting first sync';
const compactLabels:Record<string,{en:string;zh:string}>={mechanical:{en:'Mechanical Eng.',zh:'机械工程'},braking:{en:'Rail braking',zh:'铁路制动'},vibe:{en:'AI development',zh:'AI 辅助开发'}};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Lu Tao: mechanical engineering and railway braking systems. Currently focusing on AI for engineering and EM-Brake. Selected work and public activity."/><meta name="theme-color" content="#f7f6f2"/><meta property="og:title" content="Lu Tao · Mechanical Engineering × AI"/><meta property="og:description" content="Mechanical engineering, railway braking systems, and AI-assisted development. Currently focusing on AI and EM-Brake."/><meta property="og:type" content="website"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/><title>Lu Tao · Mechanical Engineering × AI</title><!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "304c1b9d27154f01a7ba117792b12e1f"}'></script><!-- End Cloudflare Web Analytics --></head><body class="profile-page">
<a class="skip" href="#main">Skip to content</a><div class="page-shell">
<div class="profile-dock"><div class="dock-inner"><section class="hero" id="about" aria-label="Professional profile">
<button id="language" class="language-toggle" aria-label="Switch to Chinese">中文 ↗</button>
<div class="profile-heading"><div class="profile-identity"><Image src={avatar} alt="Portrait of Lu Tao" width={88} height={88} widths={[88,176]} sizes="(max-width:640px) 64px, 88px" format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-avatar"/><div class="identity-copy"><div class="identity-line"><h1>{profile.name}</h1><span class="profile-handle">@{profile.handle}</span></div><p class="professional-role" data-en="Mechanical engineering · Railway braking" data-zh="机械工程 · 铁路制动系统">Mechanical engineering · Railway braking</p><p class="focus-line"><span class="focus-dot" aria-hidden="true"></span><span data-en="Currently focusing on" data-zh="目前专注于">Currently focusing on</span><strong>AI <span aria-hidden="true">×</span> EM-Brake</strong></p></div></div>
<p class="profile-thesis" data-en="Bringing railway braking and systems integration experience into verifiable AI engineering practice." data-zh="把铁路制动与系统集成经验，带入可验证的 AI 工程实践。">Bringing railway braking and systems integration experience into verifiable AI engineering practice.</p>
<div class="experience-summary" aria-label="Experience"><div class="experience-metrics">{profile.experiences.map(e=><div class="experience-metric"><div><strong data-experience-years={e.years} data-baseline-year={profile.experienceBaselineYear}>{experienceYears(e.years,profile.experienceBaselineYear,year)}+</strong><span class="years-unit" data-en="years" data-zh="年">years</span></div><span class="experience-label"><span class="label-full" data-en={e.en} data-zh={e.zh}>{e.en}</span><span class="label-short" data-en={compactLabels[e.id]?.en??e.en} data-zh={compactLabels[e.id]?.zh??e.zh}>{compactLabels[e.id]?.en??e.en}</span></span></div>)}</div></div></div>
<div class="profile-bottom"><span class="profile-location"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M12.5 6.5c0 3-4.5 7-4.5 7s-4.5-4-4.5-7a4.5 4.5 0 1 1 9 0Z" fill="none" stroke="currentColor"/><circle cx="8" cy="6.5" r="1.5" fill="none" stroke="currentColor"/></svg><span data-en="Suzhou, China" data-zh="中国 · 苏州">Suzhou, China</span></span><nav class="profile-contacts" aria-label="Contact and profiles"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={`mailto:${profile.email}`} title={profile.email}>Email <span aria-hidden="true">↗</span></a></nav></div>
</section><TrainDivider/></div></div><div class="dock-spacer" aria-hidden="true"></div><main id="main" tabindex="-1">
<Background/>
<section class="work section" id="work"><div class="section-title"><div><span class="eyebrow">02 / SELECTED WORK</span><h2 data-en="Ideas, made tangible." data-zh="让想法成为作品。">Ideas, made tangible.</h2></div><a class="text-link" href="https://github.com/hilt21?tab=repositories" target="_blank" rel="noopener noreferrer"><span data-en="All repositories" data-zh="全部仓库">All repositories</span>↗</a></div><div class="project-grid">{profile.projects.map((p,i)=><article class="project-card"><a href={p.url} class="art-link" aria-label={`Explore ${p.name}`} target="_blank" rel="noopener noreferrer"><ProjectArt kind={p.kind}/><span class="art-arrow">↗</span></a><div class="project-info"><div class="project-meta"><span class="mono">0{i+1} / {p.category}</span><span class:list={['status',['Published','Live MVP'].includes(p.status)?'deployed':'']}>{p.status}</span></div><h3><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></h3><p data-en={p.description} data-zh={p.zh}>{p.description}</p>{p.id==='NovaCreo'&&<small class="project-limit" data-en="Core prototype; live Creo adapter pending." data-zh="核心原型；真实 Creo 适配层待实现。">Core prototype; live Creo adapter pending.</small>}{projectSnapshot.items.find(m=>m.repo===p.repo)&&<div class="project-metrics">{projectSnapshot.items.filter(m=>m.repo===p.repo).map(m=><><span>★ {m.stars}</span><span data-en={`Code updated ${m.pushedAt.slice(0,10)}`} data-zh={`代码更新于 ${m.pushedAt.slice(0,10)}`}>Code updated {m.pushedAt.slice(0,10)}</span></>)}</div>}<div class="project-bottom"><div class="stack">{p.stack.map(t=><span>{t}</span>)}</div><a href={p.repo} aria-label={`${p.name} source code`} target="_blank" rel="noopener noreferrer">↗</a></div></div></article>)}</div></section>
<section class="activity section" id="activity"><div class="section-title"><div><span class="eyebrow">03 / THE PRACTICE</span><h2 data-en="A little, consistently." data-zh="持续做一点。">A little, consistently.</h2></div></div>
<div class="activity-grid">
<ChatGPTActivity />
<section class="activity-panel" id="github-panel" aria-labelledby="github-heading">
  <div class="activity-panel-heading"><h3 id="github-heading">GitHub</h3><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">↗</a></div>
  <div class="activity-metrics">
    <div><span data-en="Contributions · last year" data-zh="贡献 · 过去一年">Contributions · last year</span><strong>{data.totalContributions??'—'}</strong></div>
    <div><span data-en="Active days · last year" data-zh="活跃天数 · 过去一年">Active days · last year</span><strong>{activeDays||'—'}</strong></div>
    <div><span data-en="Public repositories" data-zh="公开仓库">Public repositories</span><strong>{data.repositories??'—'}</strong></div>
  </div>
  <ActivityCalendar days={githubDays} label="GitHub contribution calendar · last 183 days" metric="contributions" />
  <details class="activity-info"><summary data-en="Data details" data-zh="数据说明">Data details</summary><p data-en="Calendar: last 183 days. Summary metrics keep their original periods; they are not six-month totals." data-zh="热力图展示最近 183 天。汇总数字保留原统计范围，并非半年总量。">Calendar: last 183 days. Summary metrics keep their original periods; they are not six-month totals.</p><p>GitHub public · {data.updatedAt??'Unknown'}</p><p data-en="Missing dates are unknown, not zero." data-zh="缺失日期为未知，不代表零活动。">Missing dates are unknown, not zero.</p><div class="activity-table"><table><caption data-en="Daily contributions · last 183 days" data-zh="每日贡献 · 最近 183 天">Daily contributions · last 183 days</caption><thead><tr><th>Date / 日期</th><th data-en="Contributions" data-zh="贡献">Contributions</th></tr></thead><tbody>{githubDays.map(day=><tr><th scope="row">{day.date}</th><td>{day.value===null?'—':day.value}</td></tr>)}</tbody></table></div></details>
</section>
</div></section>
<section class="closing"><span class="eyebrow">ALWAYS A WORK IN PROGRESS</span><h2><span data-en="Better systems." data-zh="更好的系统。">Better systems.</span><br/><span class="serif" data-en="Built with curiosity." data-zh="始于好奇。">Built with curiosity.</span></h2><a href={profile.github} target="_blank" rel="noopener noreferrer" class="primary-link"><span data-en="Find me on GitHub" data-zh="在 GitHub 找到我">Find me on GitHub</span>↗</a></section><SiteInsights/></main>
<footer><div><a href="#" class="footer-brand">Lu Tao</a><span data-en="Engineering × AI × Human judgment" data-zh="工程 × AI × 人的判断">Engineering × AI × Human judgment</span></div><div class="provenance"><span><span class="live-dot"></span>GitHub snapshot · {updated}<span id="freshness" data-updated={data.updatedAt} data-status={data.status}></span></span><span data-en="Profile reviewed Oct 12, 2026 · Public sources only" data-zh="画像核对于 2026-10-12 · 仅展示公开资料">Profile reviewed Oct 12, 2026 · Public sources only</span><a href={profile.github} target="_blank" rel="noopener noreferrer" data-en="Source: GitHub public contributions & repositories ↗" data-zh="来源：GitHub 公开贡献与仓库 ↗">Source: GitHub public contributions & repositories ↗</a></div><a href="#" class="back-top" aria-label="Back to top">↑</a></footer></div>
<script>
import {experienceYears,profileYear} from '../lib/experience';
function refreshExperience(){const year=profileYear();document.querySelectorAll<HTMLElement>('[data-experience-years]').forEach(el=>{el.textContent=`${experienceYears(Number(el.dataset.experienceYears),Number(el.dataset.baselineYear),year)}+`;});}
refreshExperience();document.addEventListener('visibilitychange',refreshExperience);setInterval(refreshExperience,3600000);
const dock=document.querySelector<HTMLElement>('.profile-dock')!;
function measureLayout(){document.documentElement.style.setProperty('--dock-height',`${dock.getBoundingClientRect().height}px`)}
new ResizeObserver(measureLayout).observe(dock);window.addEventListener('resize',measureLayout);document.fonts.ready.then(measureLayout);measureLayout();
let locale='en';try{locale=localStorage.getItem('profile-language')||'en';}catch{}
function setLanguage(lang:string){document.documentElement.lang=lang==='zh'?'zh-CN':'en';document.querySelectorAll<HTMLElement>('[data-en][data-zh]').forEach(el=>el.textContent=el.dataset[lang]||'');const b=document.querySelector<HTMLButtonElement>('#language')!;b.textContent=lang==='en'?'中文 ↗':'EN ↗';b.setAttribute('aria-label',lang==='en'?'Switch to Chinese':'Switch to English');try{localStorage.setItem('profile-language',lang)}catch{}requestAnimationFrame(measureLayout)}
setLanguage(locale);document.querySelector('#language')?.addEventListener('click',()=>{locale=locale==='en'?'zh':'en';setLanguage(locale)});
const freshness=document.querySelector<HTMLElement>('#freshness')!;if(!freshness.dataset.updated||freshness.dataset.status!=='ok'||Date.now()-Date.parse(freshness.dataset.updated)>10*24*3600*1000){freshness.textContent=' · Update overdue';freshness.classList.add('stale')}
</script></body></html>
