---
const {kind}=Astro.props;
---
<svg viewBox="0 0 480 210" fill="none" aria-hidden="true" class:list={['project-art',kind]}>
{kind==='lexicon'&&<>
 <path d="M80 67L181 39L229 94L135 139L80 67ZM181 39L298 58L229 94M135 139L253 167L345 117L298 58M229 94L253 167M229 94L345 117" stroke="currentColor" stroke-width="1"/>
 {[ [80,67],[181,39],[229,94],[135,139],[298,58],[253,167],[345,117] ].map(([x,y],i)=><g><circle cx={x} cy={y} r={i===2?13:6} fill={i===2?'#bb593d':'#ddd9ce'} stroke="currentColor"/><circle cx={x} cy={y} r="2" fill="currentColor"/></g>)}
 <text x="358" y="120">[ knowledge ]</text><text x="57" y="171">01 / CONNECT THE IDEAS</text>
</>}
{kind==='cad'&&<>
 <path d="M184 46L282 73V151L184 124V46ZM184 46L124 83V160L184 124M124 83L220 112L282 73M220 112V188L124 160M220 188L282 151M184 124L220 134" stroke="currentColor" stroke-width="1.2"/>
 <path d="M113 57L290 108M113 176L290 129M201 28V195" stroke="currentColor" stroke-dasharray="3 5" opacity=".3"/>
 <circle cx="184" cy="124" r="4" fill="#bb593d"/><text x="303" y="88">VALIDATE</text><text x="303" y="105">→ EXECUTE</text><text x="303" y="122">→ VERIFY</text><text x="37" y="184">02 / MAKE IT REPEATABLE</text>
</>}
{kind==='learning'&&<>
 <path d="M120 72C152 38 210 43 228 75M255 75C293 43 350 72 348 110M339 138C314 169 267 171 244 143M211 144C176 168 127 150 122 116" stroke="currentColor" stroke-width="1.2"/>
 {[ [115,94,'CAPTURE'],[242,94,'UNDERSTAND'],[242,144,'REVISIT'] ].map(([x,y,t])=><g><rect x={Number(x)-41} y={Number(y)-13} width="82" height="27" rx="3" fill="#e6e9df" stroke="currentColor" stroke-opacity=".4"/><text x={x} y={Number(y)+3} text-anchor="middle">{t}</text></g>)}
 <circle cx="348" cy="121" r="7" fill="#bb593d"/><text x="37" y="184">03 / CLOSE THE LEARNING LOOP</text>
</>}
{kind==='effects'&&<>
 {Array.from({length:13},(_,i)=><path d={`M${65+i*17} 168 L${134+i*12} ${88-i*2} L${203+i*10} ${127-i*3} L${295+i*7} 29`} stroke={i%3===0?'#bb593d':'currentColor'} opacity={.2+i*.045} stroke-width="1.3"/>)}
 <text x="37" y="192">04 / FOLLOW YOUR CURIOSITY</text>
</>}
</svg>
