---
interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
import raw from '../data/site-analytics.json';
import { SiteAnalyticsSnapshot } from '../lib/schema';
import { snapshotOverdue } from '../lib/snapshot-freshness';

const data = SiteAnalyticsSnapshot.parse(raw);
const available = data.updatedAt !== null && data.totals !== null;
const recent = data.daily.slice(-7);
const peak = Math.max(1,...recent.map(day=>day.pageViews??0));
const segments: string[] = [];
const isolated: {x:number;y:number}[] = [];
let run: {x:number;y:number}[] = [];
function closeRun() {
  if (run.length>1) segments.push(run.map((p,i)=>(i===0?'M':'L')+p.x+' '+p.y).join(' '));
  else if (run.length===1) isolated.push(run[0]);
  run=[];
}
recent.forEach((day,i)=>{
  if (day.pageViews===null) {closeRun();return;}
  run.push({x:Math.round(i*140/6),y:Math.round(42-day.pageViews*34/peak)});
});
closeRun();
const recentKnown = recent.some(day=>day.pageViews!==null);
const hasGap = recent.some(day=>day.pageViews===null);
const first = data.coverage.from;
const periodPartial = !!first && first>data.period.from;
function shortDate(date: string) {
  return new Date(date+'T00:00:00Z').toLocaleDateString(locale==='zh'?'zh-CN':'en-US',
    {month:'short',day:'numeric',timeZone:'UTC'});
}
const periodLabel = periodPartial && first
  ? shortDate(first)+' – '+shortDate(data.period.to)+' · UTC'
  : (locale==='zh'?'最近 30 个完整自然日 · UTC':'LAST 30 COMPLETE DAYS · UTC');
const updatedLabel = new Date(data.updatedAt).toLocaleDateString(locale==='zh'?'zh-CN':'en-US',
  {month:'short',day:'numeric',timeZone:'UTC'});
const stale = snapshotOverdue(data.updatedAt,48*60*60*1000,data.status);
const incomplete = data.coverage.missingDays>0;
---
<section class="site-insights" id="site-insights" aria-label={locale==='zh'?'网站访问统计':'Site traffic'} data-updated={data.updatedAt} data-status={data.status}>
  <div class="site-insights-heading">
    <span class="site-insights-eyebrow">SITE INSIGHTS</span>
    <span class="site-insights-window">{periodLabel}</span>
  </div>
  {available ? (
    <div class="site-insights-content">
      <div class="site-insights-metrics">
        <div class="site-insights-metric">
          <strong>{incomplete?'≥':''}{data.totals?.visits.toLocaleString('en-US')}</strong>
          <span>{locale==='zh'?'访问次数':'Visits'}</span>
        </div>
        <div class="site-insights-metric">
          <strong>{incomplete?'≥':''}{data.totals?.pageViews.toLocaleString('en-US')}</strong>
          <span>{locale==='zh'?'页面浏览量':'Page Views'}</span>
        </div>
      </div>
      <div class="site-insights-trend">
        {recentKnown ? (
          <svg viewBox="0 0 140 48" role="img" aria-label={locale==='zh'?'最近七个完整 UTC 日的已确认页面浏览量':'Verified page views in the last seven complete UTC days'}>
            {segments.map(path=><path d={path} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>)}
            {isolated.map(p=><circle cx={p.x} cy={p.y} r="2.3" fill="currentColor"/>)}
          </svg>
        ):(
          <span>{locale==='zh'?'暂无可信趋势':'Trend unavailable'}</span>
        )}
        <span>{locale==='zh'?'7 天趋势':'7-DAY TREND'}{hasGap?' · '+(locale==='zh'?'有缺口':'GAPS'):''}</span>
      </div>
    </div>
  ) : (
    <p class="site-insights-unavailable">{locale==='zh'?'网站访问统计暂不可用。':'Site analytics are temporarily unavailable.'}</p>
  )}
  <div class="site-insights-provenance">
    <span>{locale==='zh'?'Cloudflare 网站分析':'Cloudflare Web Analytics'}{incomplete?' · '+(locale==='zh'?'仅已记录数据':'recorded data only'):''}</span>
    <span>
      {available && <span>{locale==='zh'?'更新于 '+updatedLabel+' · UTC':'Updated '+updatedLabel+' · UTC'}</span>}
      {incomplete && <span>{' · '+data.coverage.missingDays+(locale==='zh'?' 天缺失':' missing days')}</span>}
      <span id="site-insights-stale" class="site-insights-stale" hidden={!stale}>{locale==='zh'?' · 更新延迟':' · update overdue'}</span>
    </span>
  </div>
</section>
<script>
import { snapshotOverdue } from '../lib/snapshot-freshness';
const section=document.querySelector<HTMLElement>('#site-insights');
const mark=document.querySelector<HTMLElement>('#site-insights-stale');
if(section&&mark){
  const updated=section.dataset.updated;
  if(snapshotOverdue(updated,48*60*60*1000,section.dataset.status))mark.hidden=false;
}
</script>
