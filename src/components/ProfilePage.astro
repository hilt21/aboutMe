---
interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
import '../styles/global.css';
import '../styles/profile.css';
import '../styles/activity.css';
import '../styles/profile-preview.css';
import {Image} from 'astro:assets';
import avatar from '../assets/lu-tao-avatar.webp';
import profileRaw from '../data/profile.json';
import raw from '../data/github.json';
import {Snapshot,Profile} from '../lib/schema';
import {experienceYears,profileYear} from '../lib/experience';
import TrainDivider from '../components/TrainDivider.astro';
import ScrollNavigation from '../components/ScrollNavigation.astro';
import Background from '../components/Background.astro';
import SiteInsights from '../components/SiteInsights.astro';
import ChatGPTActivity from '../components/ChatGPTActivity.astro';
import ActivityCalendar from '../components/ActivityCalendar.astro';
import { activityCalendar } from '../lib/activity-view';
import {metadata,localizedUrls,profileStructuredData} from '../lib/seo';
const profile=Profile.parse(profileRaw);
const seo=metadata[locale];
const urls=localizedUrls(Astro.site!,import.meta.env.BASE_URL);
const otherLocale=locale==='en'?'zh':'en';
const structuredData=profileStructuredData(profile,locale,urls,new URL(avatar.src,Astro.site).href);
const year=profileYear();
const data=Snapshot.parse(raw),days=data.calendar;
const activeDays=days.filter(d=>d.count>0).length;
const activityEnd=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const githubDays=activityCalendar(days.map(day=>({date:day.date,value:day.count,level:day.level})),activityEnd);
const updated=data.updatedAt?new Date(data.updatedAt).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric',timeZone:'Asia/Shanghai'}):'Awaiting first sync';
const compactLabels:Record<string,{en:string;zh:string}>={mechanical:{en:'Mechanical Eng.',zh:'机械工程'},braking:{en:'Rail braking',zh:'铁路制动'},vibe:{en:'AI development',zh:'AI 辅助开发'}};
---
<!doctype html><html lang={seo.language}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={seo.description}/><meta name="theme-color" content="#f7f6f2"/><meta property="og:title" content={seo.title}/><meta property="og:description" content={seo.description}/><meta property="og:type" content="profile"/><meta property="og:url" content={urls[locale]}/><link rel="canonical" href={urls[locale]}/><link rel="alternate" hreflang="en" href={urls.en}/><link rel="alternate" hreflang="zh-CN" href={urls.zh}/><link rel="alternate" hreflang="x-default" href={urls.en}/><link rel="sitemap" type="application/xml" href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/sitemap.xml`}/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/><title>{seo.title}</title><script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll('<','\\u003c')}/>
<!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "304c1b9d27154f01a7ba117792b12e1f"}'></script><!-- End Cloudflare Web Analytics --></head><body class="profile-page">
<a class="skip" href="#main">{locale==='zh'?'跳至正文':'Skip to content'}</a><div class="page-shell">
<ScrollNavigation locale={locale} email={profile.email} />
<div class="profile-dock"><div class="dock-inner"><section class="hero" id="about" aria-label="Professional profile">
<a id="language" class="language-toggle" href={new URL(urls[otherLocale]).pathname} hreflang={metadata[otherLocale].language} lang={metadata[otherLocale].language} aria-label={locale==='en'?'Switch to Chinese':'Switch to English'}>{locale==='en'?'中文 ↗':'EN ↗'}</a>
<div class="profile-heading"><div class="profile-identity"><Image src={avatar} alt={locale==='zh'?'Lu Tao 的头像':'Portrait of Lu Tao'} width={88} height={88} widths={[88,176]} sizes="(max-width:640px) 64px, 88px" format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-avatar"/><div class="identity-copy"><div class="identity-line"><h1>{profile.name}</h1><span class="profile-handle">@{profile.handle}</span></div><p class="professional-role">{locale === 'zh' ? "机械工程 · 铁路制动系统" : "Mechanical engineering · Railway braking"}</p><p class="focus-line"><span class="focus-dot" aria-hidden="true"></span><span>{locale === 'zh' ? "目前专注于" : "Currently focusing on"}</span><strong>AI <span aria-hidden="true">×</span> EM-Brake</strong></p></div></div>
<p class="profile-thesis">{locale === 'zh' ? "把铁路制动与系统集成经验，带入可验证的 AI 工程实践。" : "Bringing railway braking and systems integration experience into verifiable AI engineering practice."}</p>
<div class="profile-actions" id="work"><a class="project-index-link" href="https://hilt21.github.io/#projects">{locale==='zh'?'项目索引':'Project Atlas'}<span aria-hidden="true">→</span>{locale==='en'&&<small lang="zh-CN">中文</small>}</a><a class="practice-link" href="#activity">{locale==='zh'?'持续实践':'Practice'}<span aria-hidden="true">↓</span></a></div>
<div class="experience-summary" aria-label="Experience"><div class="experience-metrics">{profile.experiences.map(e=><div class="experience-metric"><div><strong data-experience-years={e.years} data-baseline-year={profile.experienceBaselineYear}>{experienceYears(e.years,profile.experienceBaselineYear,year)}+</strong><span class="years-unit">{locale === 'zh' ? "年" : "years"}</span></div><span class="experience-label"><span class="label-full">{locale === 'zh' ? e.zh : e.en}</span><span class="label-short">{locale === 'zh' ? compactLabels[e.id]?.zh??e.zh : compactLabels[e.id]?.en??e.en}</span></span></div>)}</div></div></div>
<div class="profile-bottom"><span class="profile-location"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M12.5 6.5c0 3-4.5 7-4.5 7s-4.5-4-4.5-7a4.5 4.5 0 1 1 9 0Z" fill="none" stroke="currentColor"/><circle cx="8" cy="6.5" r="1.5" fill="none" stroke="currentColor"/></svg><span>{locale === 'zh' ? "中国 · 苏州" : "Suzhou, China"}</span></span><nav class="profile-contacts" aria-label="Contact and profiles"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={`mailto:${profile.email}`} title={profile.email}>Email <span aria-hidden="true">↗</span></a></nav></div>
</section><TrainDivider/></div></div><main id="main" tabindex="-1">
<Background locale={locale}/>
<section class="activity section" id="activity"><div class="section-title"><div><span class="eyebrow">02 / THE PRACTICE</span><h2>{locale === 'zh' ? "持续做一点。" : "A little, consistently."}</h2></div></div>
<div class="activity-grid">
<ChatGPTActivity locale={locale} />
<section class="activity-panel" id="github-panel" aria-labelledby="github-heading">
  <div class="activity-panel-heading"><h3 id="github-heading">GitHub</h3><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">↗</a></div>
  <div class="activity-metrics">
    <div><span>{locale === 'zh' ? "贡献 · 过去一年" : "Contributions · last year"}</span><strong>{data.totalContributions??'—'}</strong></div>
    <div><span>{locale === 'zh' ? "活跃天数 · 过去一年" : "Active days · last year"}</span><strong>{activeDays||'—'}</strong></div>
    <div><span>{locale === 'zh' ? "公开仓库" : "Public repositories"}</span><strong>{data.repositories??'—'}</strong></div>
  </div>
  <ActivityCalendar locale={locale} days={githubDays} label="GitHub contribution calendar · last 183 days" metric="contributions" />
  <details class="activity-info"><summary>{locale === 'zh' ? "数据说明" : "Data details"}</summary><p>{locale === 'zh' ? "热力图展示最近 183 天。汇总数字保留原统计范围，并非半年总量。" : "Calendar: last 183 days. Summary metrics keep their original periods; they are not six-month totals."}</p><p>GitHub public · {data.updatedAt??'Unknown'}</p><p>{locale === 'zh' ? "缺失日期为未知，不代表零活动。" : "Missing dates are unknown, not zero."}</p><div class="activity-table"><table><caption>{locale === 'zh' ? "每日贡献 · 最近 183 天" : "Daily contributions · last 183 days"}</caption><thead><tr><th>Date / 日期</th><th>{locale === 'zh' ? "贡献" : "Contributions"}</th></tr></thead><tbody>{githubDays.map(day=><tr><th scope="row">{day.date}</th><td>{day.value===null?'—':day.value}</td></tr>)}</tbody></table></div></details>
</section>
</div></section>
<section class="closing"><span class="eyebrow">ALWAYS A WORK IN PROGRESS</span><h2><span>{locale === 'zh' ? "更好的系统。" : "Better systems."}</span><br/><span class="serif">{locale === 'zh' ? "始于好奇。" : "Built with curiosity."}</span></h2><a href={profile.github} target="_blank" rel="noopener noreferrer" class="primary-link"><span>{locale === 'zh' ? "在 GitHub 找到我" : "Find me on GitHub"}</span>↗</a></section><SiteInsights locale={locale}/></main>
<footer><div><a href="#" class="footer-brand">Lu Tao</a><span>{locale === 'zh' ? "工程 × AI × 人的判断" : "Engineering × AI × Human judgment"}</span></div><div class="provenance"><span><span class="live-dot"></span>GitHub snapshot · {updated}<span id="freshness" data-updated={data.updatedAt} data-status={data.status}></span></span><span>{locale === 'zh' ? "画像核对于 2026-10-12 · 仅展示公开资料" : "Profile reviewed Oct 12, 2026 · Public sources only"}</span><a href={profile.github} target="_blank" rel="noopener noreferrer">{locale === 'zh' ? "来源：GitHub 公开贡献与仓库 ↗" : "Source: GitHub public contributions & repositories ↗"}</a></div><a href="#" class="back-top" aria-label="Back to top">↑</a></footer></div>
<script>
import {experienceYears,profileYear} from '../lib/experience';
function refreshExperience(){const year=profileYear();document.querySelectorAll<HTMLElement>('[data-experience-years]').forEach(el=>{el.textContent=`${experienceYears(Number(el.dataset.experienceYears),Number(el.dataset.baselineYear),year)}+`;});}
refreshExperience();document.addEventListener('visibilitychange',refreshExperience);setInterval(refreshExperience,3600000);
// The URL owns the locale. Retire the old preference without redirecting deep links.
try{localStorage.removeItem('profile-language')}catch{}
const freshness=document.querySelector<HTMLElement>('#freshness')!;if(!freshness.dataset.updated||freshness.dataset.status!=='ok'||Date.now()-Date.parse(freshness.dataset.updated)>10*24*3600*1000){freshness.textContent=document.documentElement.lang==='zh-CN'?' · 更新延迟':' · Update overdue';freshness.classList.add('stale')}
</script></body></html>
