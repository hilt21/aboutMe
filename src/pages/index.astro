---
import '../styles/global.css';
import {Image} from 'astro:assets';
import avatar from '../assets/lu-tao-avatar.webp';
import profileRaw from '../data/profile.json';
import raw from '../data/github.json';
import projectsRaw from '../data/projects.json';
import {Snapshot,Profile,ProjectSnapshot} from '../lib/schema';
import {experienceYears,profileYear} from '../lib/experience';
import TrainDivider from '../components/TrainDivider.astro';
import ProjectArt from '../components/ProjectArt.astro';
import Background from '../components/Background.astro';
const profile=Profile.parse(profileRaw);
const year=profileYear();
const data=Snapshot.parse(raw),days=data.calendar;
const projectSnapshot=ProjectSnapshot.parse(projectsRaw);
const activeDays=days.filter(d=>d.count>0).length;
const cells=[...Array.from({length:days.length?new Date(days[0].date+'T00:00:00Z').getUTCDay():0},()=>null),...days];
const months=Array.from({length:Math.ceil(cells.length/7)},(_,i)=>{const d=cells[i*7];return d&&(i===0||new Date(d.date).getUTCDate()<=7)?new Date(d.date+'T00:00:00Z').toLocaleDateString('en',{month:'short',timeZone:'UTC'}):''});
const updated=data.updatedAt?new Date(data.updatedAt).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric',timeZone:'Asia/Shanghai'}):'Awaiting first sync';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Lu Tao: mechanical engineering and railway braking systems. Currently focusing on AI for engineering and EM-Brake. Selected work and public activity."/><meta name="theme-color" content="#f7f6f2"/><meta property="og:title" content="Lu Tao · Mechanical Engineering × AI"/><meta property="og:description" content="Mechanical engineering, railway braking systems, and AI-assisted development. Currently focusing on AI and EM-Brake."/><meta property="og:type" content="website"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/><title>Lu Tao · Mechanical Engineering × AI</title><!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "304c1b9d27154f01a7ba117792b12e1f"}'></script><!-- End Cloudflare Web Analytics --></head><body>
<a class="skip" href="#main">Skip to content</a><div class="page-shell">
<div class="profile-dock"><div class="dock-inner"><section class="hero" id="about" aria-label="Professional profile">
<button id="language" class="language-toggle" aria-label="Switch to Chinese">中文 ↗</button>
<div class="profile-heading"><div class="profile-identity"><Image src={avatar} alt="Portrait of Lu Tao" width={88} height={88} widths={[88,176]} sizes="(max-width:640px) 64px, 88px" format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-avatar"/><div class="identity-copy"><div class="identity-line"><h1>{profile.name}</h1><span class="profile-handle">@{profile.handle}</span></div><p class="professional-role" data-en="Mechanical engineering · Railway braking" data-zh="机械工程 · 铁路制动系统">Mechanical engineering · Railway braking</p><p class="focus-line"><span class="focus-dot" aria-hidden="true"></span><span data-en="Currently focusing on" data-zh="目前专注于">Currently focusing on</span><strong>AI <span aria-hidden="true">×</span> EM-Brake</strong></p></div></div>
<div class="experience-summary" aria-label="Experience"><div class="experience-metrics">{profile.experiences.map(e=><div class="experience-metric"><div><strong data-experience-years={e.years} data-baseline-year={profile.experienceBaselineYear}>{experienceYears(e.years,profile.experienceBaselineYear,year)}+</strong><span class="years-unit" data-en="years" data-zh="年">years</span></div><span class="experience-label" data-en={e.en} data-zh={e.zh}>{e.en}</span></div>)}</div></div></div>
<div class="profile-bottom"><span class="profile-location"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M12.5 6.5c0 3-4.5 7-4.5 7s-4.5-4-4.5-7a4.5 4.5 0 1 1 9 0Z" fill="none" stroke="currentColor"/><circle cx="8" cy="6.5" r="1.5" fill="none" stroke="currentColor"/></svg><span data-en="Suzhou, China" data-zh="中国 · 苏州">Suzhou, China</span></span><nav class="profile-contacts" aria-label="Contact and profiles"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={`mailto:${profile.email}`} title={profile.email}>Email <span aria-hidden="true">↗</span></a></nav></div>
</section><TrainDivider/></div></div><div class="dock-spacer" aria-hidden="true"></div><main id="main" tabindex="-1">
<Background/>
<section class="work section" id="work"><div class="section-title"><div><span class="eyebrow">02 / SELECTED WORK</span><h2 data-en="Ideas, made tangible." data-zh="让想法成为作品。">Ideas, made tangible.</h2></div><a class="text-link" href="https://github.com/hilt21?tab=repositories" target="_blank" rel="noopener noreferrer"><span data-en="All repositories" data-zh="全部仓库">All repositories</span>↗</a></div><div class="project-grid">{profile.projects.map((p,i)=><article class="project-card"><a href={p.url} class="art-link" aria-label={`Explore ${p.name}`} target="_blank" rel="noopener noreferrer"><ProjectArt kind={p.kind}/><span class="art-arrow">↗</span></a><div class="project-info"><div class="project-meta"><span class="mono">0{i+1} / {p.category}</span><span class:list={['status',['Published','Live MVP'].includes(p.status)?'deployed':'']}>{p.status}</span></div><h3><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></h3><p data-en={p.description} data-zh={p.zh}>{p.description}</p>{p.id==='NovaCreo'&&<small class="project-limit" data-en="Core prototype; live Creo adapter pending." data-zh="核心原型；真实 Creo 适配层待实现。">Core prototype; live Creo adapter pending.</small>}{projectSnapshot.items.find(m=>m.repo===p.repo)&&<div class="project-metrics">{projectSnapshot.items.filter(m=>m.repo===p.repo).map(m=><><span>★ {m.stars}</span><span data-en={`Code updated ${m.pushedAt.slice(0,10)}`} data-zh={`代码更新于 ${m.pushedAt.slice(0,10)}`}>Code updated {m.pushedAt.slice(0,10)}</span></>)}</div>}<div class="project-bottom"><div class="stack">{p.stack.map(t=><span>{t}</span>)}</div><a href={p.repo} aria-label={`${p.name} source code`} target="_blank" rel="noopener noreferrer">↗</a></div></div></article>)}</div></section>
<section class="activity section" id="activity"><div class="section-title"><div><span class="eyebrow">03 / THE PRACTICE</span><h2 data-en="A little, consistently." data-zh="持续做一点。">A little, consistently.</h2></div><div class="source-tabs" role="tablist" aria-label="Activity source"><button id="github-tab" role="tab" aria-selected="true" aria-controls="github-panel">GitHub</button><button id="codex-tab" role="tab" aria-selected="false" aria-controls="codex-panel" tabindex="-1">Codex <span class="tiny-dot"></span></button></div></div>
<div id="github-panel" role="tabpanel" aria-labelledby="github-tab"><div class="activity-stats"><div><strong>{data.totalContributions??'—'}</strong><span data-en="contributions in the last year" data-zh="过去一年的贡献">contributions in the last year</span></div><div><strong>{activeDays||'—'}</strong><span data-en="active days" data-zh="活跃天数">active days</span></div><div><strong>{data.repositories??'—'}</strong><span data-en="public repositories" data-zh="公开仓库">public repositories</span></div><a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-link"><span data-en="View on GitHub" data-zh="前往 GitHub">View on GitHub</span>↗</a></div>
{days.length>0?<div class="calendar-scroll" tabindex="0" role="region" aria-label="Contribution calendar. Scroll horizontally on narrow screens."><div class="calendar-inner"><div class="calendar-months">{months.map(m=><span>{m}</span>)}</div><div class="calendar-row"><div class="day-labels"><span>Mon</span><span>Wed</span><span>Fri</span></div><div class="heatmap" role="img" aria-label={`${data.totalContributions} GitHub contributions across ${activeDays} active days in the last year`}>{cells.map(d=>d?<button class={`day level-${d.level}`} tabindex="-1" aria-label={`${d.date}: ${d.count} contributions`} data-tooltip={`${d.date} · ${d.count} contributions`}></button>:<span class="day blank"></span>)}</div></div></div></div>:<p>GitHub data is temporarily unavailable.</p>}
<div class="calendar-foot"><span class="mono">{days[0]?.date} → {days.at(-1)?.date}</span><div class="legend"><span>Less</span>{[0,1,2,3,4].map(i=><i class={`level-${i}`}></i>)}<span>More</span></div></div></div>
<div id="codex-panel" role="tabpanel" aria-labelledby="codex-tab" hidden><div class="codex-empty"><span class="codex-symbol">⌘</span><div><h3 data-en="Good work deserves a thoughtful record." data-zh="认真做的事，值得认真记录。">Good work deserves a thoughtful record.</h3><p data-en="Codex activity is not connected yet. A local collector can publish daily totals without sharing prompts, code, or session history." data-zh="Codex 活动尚未接入。本地采集器可发布每日汇总，同时保留提示词、代码和会话记录的隐私。">Codex activity is not connected yet. A local collector can publish daily totals without sharing prompts, code, or session history.</p><span class="mono" data-en="PLANNED · LOCAL COLLECTION / PUBLIC AGGREGATES" data-zh="计划中 · 本地采集 / 公开汇总">PLANNED · LOCAL COLLECTION / PUBLIC AGGREGATES</span></div></div></div>
<p class="activity-note" data-en="Activity is a record of practice. Project evidence tells the fuller story." data-zh="活动记录持续实践，项目证据呈现更完整的成果。">Activity is a record of practice. Project evidence tells the fuller story.</p></section>
<section class="closing"><span class="eyebrow">ALWAYS A WORK IN PROGRESS</span><h2><span data-en="Better systems." data-zh="更好的系统。">Better systems.</span><br/><span class="serif" data-en="Built with curiosity." data-zh="始于好奇。">Built with curiosity.</span></h2><a href={profile.github} target="_blank" rel="noopener noreferrer" class="primary-link"><span data-en="Find me on GitHub" data-zh="在 GitHub 找到我">Find me on GitHub</span>↗</a></section></main>
<footer><div><a href="#" class="footer-brand">Lu Tao</a><span data-en="Engineering × AI × Human judgment" data-zh="工程 × AI × 人的判断">Engineering × AI × Human judgment</span></div><div class="provenance"><span><span class="live-dot"></span>GitHub snapshot · {updated}<span id="freshness" data-updated={data.updatedAt} data-status={data.status}></span></span><span data-en="Profile reviewed Oct 12, 2026 · Public sources only" data-zh="画像核对于 2026-10-12 · 仅展示公开资料">Profile reviewed Oct 12, 2026 · Public sources only</span><a href={profile.github} target="_blank" rel="noopener noreferrer" data-en="Source: GitHub public contributions & repositories ↗" data-zh="来源：GitHub 公开贡献与仓库 ↗">Source: GitHub public contributions & repositories ↗</a></div><a href="#" class="back-top" aria-label="Back to top">↑</a></footer></div><div id="day-tooltip" role="tooltip" hidden></div>
<script>
import {experienceYears,profileYear} from '../lib/experience';
function refreshExperience(){const year=profileYear();document.querySelectorAll<HTMLElement>('[data-experience-years]').forEach(el=>{el.textContent=`${experienceYears(Number(el.dataset.experienceYears),Number(el.dataset.baselineYear),year)}+`;});}
refreshExperience();document.addEventListener('visibilitychange',refreshExperience);setInterval(refreshExperience,3600000);
const dock=document.querySelector<HTMLElement>('.profile-dock')!;
const syncDockHeight=()=>document.documentElement.style.setProperty('--dock-height',`${dock.getBoundingClientRect().height}px`);
new ResizeObserver(syncDockHeight).observe(dock);syncDockHeight();
let locale='en';try{locale=localStorage.getItem('profile-language')||'en';}catch{}
function setLanguage(lang:string){document.documentElement.lang=lang==='zh'?'zh-CN':'en';document.querySelectorAll<HTMLElement>('[data-en][data-zh]').forEach(el=>el.textContent=el.dataset[lang]||'');const b=document.querySelector<HTMLButtonElement>('#language')!;b.textContent=lang==='en'?'中文 ↗':'EN ↗';b.setAttribute('aria-label',lang==='en'?'Switch to Chinese':'Switch to English');try{localStorage.setItem('profile-language',lang)}catch{}}
setLanguage(locale);document.querySelector('#language')?.addEventListener('click',()=>{locale=locale==='en'?'zh':'en';setLanguage(locale)});
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];function select(tab:HTMLButtonElement){tabs.forEach(t=>{const a=t===tab;t.setAttribute('aria-selected',String(a));t.tabIndex=a?0:-1;document.getElementById(t.getAttribute('aria-controls')!)!.hidden=!a})}
tabs.forEach((t,i)=>{t.addEventListener('click',()=>select(t));t.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const next=tabs[e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+1)%tabs.length];select(next);next.focus()}})});
const tooltip=document.querySelector<HTMLElement>('#day-tooltip')!;document.querySelectorAll<HTMLElement>('[data-tooltip]').forEach(day=>{day.addEventListener('pointerenter',()=>{const r=day.getBoundingClientRect();tooltip.textContent=day.dataset.tooltip!;tooltip.hidden=false;tooltip.style.left=Math.max(8,Math.min(r.left,innerWidth-225))+'px';tooltip.style.top=(r.top-35)+'px'});day.addEventListener('pointerleave',()=>tooltip.hidden=true);day.addEventListener('click',()=>{tooltip.hidden=false;setTimeout(()=>tooltip.hidden=true,2200)})});
const freshness=document.querySelector<HTMLElement>('#freshness')!;if(!freshness.dataset.updated||freshness.dataset.status!=='ok'||Date.now()-Date.parse(freshness.dataset.updated)>10*24*3600*1000){freshness.textContent=' · Update overdue';freshness.classList.add('stale')}
</script></body></html>
