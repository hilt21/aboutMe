<div class="train-divider" aria-hidden="true" data-train-divider>
  <div class="train-canvas"></div>
</div>
<script>
  import {mountLazyTrain} from '../lib/train/TrainBootstrap';
  const el=document.querySelector<HTMLElement>('[data-train-divider]');
  if(el) mountLazyTrain(
    el,
    async () => (await import('../lib/train/TrainScene')).mountTrain,
    async () => (await import('../lib/train/TrainFallback')).mountFallback,
  );
</script>
